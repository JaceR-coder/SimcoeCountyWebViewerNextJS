<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site config for the i-Map NextJS standalone server (see deploy/iis/README.md).

  HttpPlatformHandler starts `node server.js`, hands it a free port through HTTP_PLATFORM_PORT,
  restarts it if it dies, and forwards every request to it. IIS keeps the HTTPS binding.
  This file is never served by IIS, so the runtime secrets below are safe here - but keep the
  real values out of source control (this template has placeholders only).
-->
<configuration>
  <system.webServer>
    <!-- <clear /> matters when this runs as an application under an existing site (e.g. /imapdemo
         under the site that hosts py-Geomatics): child apps inherit the parent's handlers, and a
         parent catch-all handler would otherwise be matched before this one. -->
    <handlers>
      <clear />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <!-- processPath: node.exe on the server (Node 22). requestTimeout covers slow GeoServer layers
         and Spatial Tool previews. stdout logs go to .\logs (create it; the app pool needs write access). -->
    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments="server.js"
                  startupTimeLimit="60"
                  requestTimeout="00:05:00"
                  processesPerApplication="1"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
      <environmentVariables>
        <!-- Don't inherit a parent site's httpPlatform environment variables (e.g. py-Geomatics') -->
        <clear />
        <!-- Plumbing: listen only on the port IIS assigns, on loopback -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />

        <!-- py-Geomatics (accounts, layer permissions, GeoServer proxy). Must match the value the
             build was made with - the /geomatics rewrite is fixed at build time. -->
        <environmentVariable name="GEOMATICS_URL" value="https://ops-mz0075jf.cihs.ad.gov.on.ca/geomatics" />

        <!-- The demo's host name(s), comma-separated, exactly as users type them (port optional).
             Without it My Maps save/import and the 511 feeds return 403. -->
        <environmentVariable name="APP_ALLOWED_ORIGINS" value="DEMO-HOST-NAME" />

        <!-- ner_master: search, LHRS, My Maps share links -->
        <environmentVariable name="DATABASE_URL" value="postgresql://USER:PASSWORD@ops-mz0075jf:5432/ner_master" />

        <!-- Required by the (unused) NextAuth middleware on /api/secure - any long random string -->
        <environmentVariable name="NEXTAUTH_SECRET" value="CHANGE-ME-LONG-RANDOM-STRING" />

        <!-- Node ignores the Windows certificate store. If server-side calls to py-Geomatics fail with
             "unable to verify the first certificate" / DEPTH_ZERO_SELF_SIGNED_CERT, point this at the
             organisation's root CA exported as a Base-64 .pem file. -->
        <!-- <environmentVariable name="NODE_EXTRA_CA_CERTS" value="C:\certs\org-root-ca.pem" /> -->
      </environmentVariables>
    </httpPlatform>

    <security>
      <!-- Map requests carry long query strings (WMS params, CQL filters); IIS's 2 KB default is too small.
           allowDoubleEscaping: encoded layer names in URL paths. -->
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxQueryString="16384" maxUrl="16384" maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <!-- Let the app's own error responses (e.g. JSON 403/404 from the API) through unchanged -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
